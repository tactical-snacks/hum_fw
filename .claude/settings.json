      "Bash(~/.platformio/packages/tool-openocd/bin/openocd.exe *)",
      "Bash(~/.platformio/packages/toolchain-gccarmnoneeabi/bin/arm-none-eabi-addr2line.exe *)",
      "Bash(~/.platformio/packages/toolchain-gccarmnoneeabi/bin/arm-none-eabi-objdump.exe *)",
      "Bash(~/.platformio/penv/Scripts/python.exe -I tools/serial_capture.py *)"
    ]
  }
}
